{
  "app-id": "io.github.oddship.GnomeQuickshare",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "default-branch": "devel",
  "command": "gnome-quickshare",
  "separate-locales": false,
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--device=dri",
    "--share=network",
    "--allow=bluetooth",
    "--system-talk-name=org.bluez",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--filesystem=xdg-download"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/gnome-quickshare/cargo",
      "CARGO_NET_OFFLINE": "true",
      "CARGO_BUILD_JOBS": "2"
    }
  },
  "modules": [
    {
      "name": "protobuf-compiler",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 bin/protoc /app/bin/protoc",
        "cp -r include /app/"
      ],
      "cleanup": [
        "*"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/protocolbuffers/protobuf/releases/download/v30.1/protoc-30.1-linux-x86_64.zip",
          "sha256": "5537e15ab0c0e610f809573948d3ec7d6ef387a07991e1c361a2a0e8cad983e5",
          "only-arches": [
            "x86_64"
          ],
          "strip-components": 0
        },
        {
          "type": "archive",
          "url": "https://github.com/protocolbuffers/protobuf/releases/download/v30.2/protoc-30.2-linux-aarch_64.zip",
          "sha256": "a3173ea338ef91b1605b88c4f8120d6c8ccf36f744d9081991d595d0d4352996",
          "only-arches": [
            "aarch64"
          ],
          "strip-components": 0
        }
      ]
    },
    {
      "name": "gnome-quickshare",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --locked --offline --release --bin gnome-quickshare",
        "install -Dm755 target/release/gnome-quickshare /app/bin/gnome-quickshare",
        "bash po/install.sh /app",
        "cp -r data/icons /app/share/",
        "install -Dm644 data/io.github.oddship.GnomeQuickshare.service /app/share/dbus-1/services/io.github.oddship.GnomeQuickshare.service",
        "sed -i 's|Exec=gnome-quickshare|Exec=/app/bin/gnome-quickshare|' /app/share/dbus-1/services/io.github.oddship.GnomeQuickshare.service",
        "install -Dm644 LICENSE /app/share/licenses/gnome-quickshare/LICENSE",
        "install -Dm644 vendor/rqs_lib/LICENSE /app/share/licenses/gnome-quickshare/rqs-lib-LICENSE",
        "install -Dm644 vendor/rqs_lib/LICENSE-APACHE /app/share/licenses/gnome-quickshare/protobuf-LICENSE-APACHE",
        "install -Dm644 vendor/rqs_lib/LICENSE-CHROMIUM-BSD /app/share/licenses/gnome-quickshare/protobuf-LICENSE-CHROMIUM-BSD"
      ],
      "run-tests": true,
      "test-commands": [
        "cargo test --locked --offline --workspace --no-default-features --release"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".git",
            ".agents",
            ".codex",
            ".aws",
            "target",
            "result",
            ".flatpak-builder",
            "docs",
            "scripts",
            ".github",
            "README.md",
            "justfile",
            "flake.nix",
            "flake.lock",
            ".gitignore"
          ]
        },
        "cargo-sources.json"
      ],
      "build-options": {
        "test-args": [
          "--share=network"
        ]
      }
    }
  ]
}
